# Salsa Segura environment
# Point VITE_SUPABASE_URL at your Supabase project.
# For local Supabase dev (supabase start), use http://host.docker.internal:54321
# when running the frontend in Docker, or http://localhost:54321 for native dev.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-public-key

# Optional native shop: use the canonical Shopify domain and PUBLIC Storefront token.
# These VITE values are browser-visible. Never use Admin/private tokens or app secrets.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-token
LINER_API_KEY=your-liner-api-key

# Server-side organizer invitation redirect configuration.
# AUTH_EXTERNAL_URL is the trusted site origin used in production.
AUTH_EXTERNAL_URL=https://www.example.com
# Optional full invite URL override; never accept this from request payloads.
INVITE_REDIRECT_URL=https://www.example.com/auth/invite
# Set to local or development for the localhost fallback during local work.
ENVIRONMENT=development

# Optional server-side cookieless analytics reporting (never use VITE_ here).
# Create in the owner's Umami Cloud account under Settings > API keys.
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID=ee0f876a-ecb5-4200-a91a-3aa2f933db70
# UMAMI_API_URL=https://api.umami.is/v1
